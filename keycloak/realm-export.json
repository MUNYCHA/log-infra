{
  "realm": "logstream",
  "enabled": true,
  "displayName": "LogStream",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Can view and stream logs"
      }
    ]
  },
  "clients": [
    {
      "clientId": "logstream-ui",
      "name": "LogStream UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "_comment": "REPLACE http://REPLACE_WITH_SERVER_ORIGIN below with your exact public origin, e.g. http://10.0.0.5 (no trailing slash). Wildcards (* / +) are an open-redirect token-theft risk and must not ship to prod.",
      "redirectUris": ["http://REPLACE_WITH_SERVER_ORIGIN/*"],
      "webOrigins": ["http://REPLACE_WITH_SERVER_ORIGIN"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect"
    }
  ],
  "scopeMappings": [],
  "internationalizationEnabled": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000
}
