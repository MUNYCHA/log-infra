# ── Keycloak ──────────────────────────────────────────────────────────────────
# Initial admin credentials (change after first login)
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changeme

# Full PUBLIC base URL of your server (scheme + host[:port], NO /auth, NO trailing
# slash). Keycloak uses this to build the token issuer + login/redirect URLs, so
# it MUST match the origin the browser uses. nginx terminates HTTP and forwards
# X-Forwarded-Proto, so use the public scheme here (http for the no-TLS setup).
# Bare IP over HTTP:  http://10.0.0.5
# Behind TLS:         https://logs.example.com
KC_HOSTNAME_URL=http://10.0.0.5
