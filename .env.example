# Complete deployment configuration for the internal-office server.
# Copy this file to .env in log-infra; UI/backend repository .env files are only
# for running those projects independently during development.

# ── Office address ─────────────────────────────────────────────────────────────
# Browser-visible HTTPS nginx origin. Replace 10.0.0.5 with the server IP
# employees enter in their browsers. Do not add a trailing slash.
# This one value configures API/WebSocket allowed origin and Keycloak public URL.
APP_ORIGIN=https://10.0.0.5

# The initial Keycloak realm import resolves this value into the UI client's
# redirect URI and web origin. For an existing realm, an APP_ORIGIN change still
# requires updating those client settings in Keycloak Admin Console.

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Initial admin credentials, created only during the first Keycloak bootstrap.
# Change the password before starting the office deployment.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Persistent Keycloak PostgreSQL database credentials.
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-this-database-password

# ── UI image build ─────────────────────────────────────────────────────────────
# Standard deployment is same-origin through nginx, so REST, WebSocket, and SSO
# URLs are derived by the UI from the page address at runtime.
VITE_SSO_CLIENT_ID=logstream-ui
VITE_MAX_LOGS_PER_TOPIC=500
VITE_MAX_MESSAGE_LENGTH=50000

# ── Logstream API ──────────────────────────────────────────────────────────────
# Downloadable files on the host must be named {topic}.log, and the topic must
# also be included in LOGSTREAM_TOPICS.
LOGSTREAM_TOPICS=server-topic,system-topic,app1-topic,app2-topic,app3-topic,app4-topic
LOGSTREAM_LOG_DIR=/var/log/logstream
JVM_MAX_HEAP=512m

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Kafka remains a separately managed dependency. The broker must be attached to
# the shared monitoring network and advertise an address reachable from logstream.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=log-dashboard
KAFKA_MAX_POLL_RECORDS=500
