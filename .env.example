# Complete deployment configuration for the internal-office server.
# Copy this file to .env in log-infra and replace every <PLACEHOLDER> below.
# UI/backend repository .env files are only for running those projects
# independently during development.

# ── Office address ─────────────────────────────────────────────────────────────
# Browser-visible HTTPS nginx origin: the server IP (or hostname) employees enter
# in their browsers. No trailing slash. This one value configures the API/WebSocket
# allowed origin and Keycloak's public URL.
#
# Must be https:// — the OIDC/PKCE login uses the browser Web Crypto API, which
# only works in a secure context (HTTPS, or localhost). Plain http:// by IP will
# break login even on a private LAN. Install the matching TLS cert per certs/README.md.
#
# If HTTPS_PORT below is not 443, the port is part of the public origin and MUST
# also appear here, e.g. APP_ORIGIN=https://<SERVER_IP>:8080 — otherwise Keycloak
# rejects login with an origin/redirect mismatch. For 443, omit the port.
APP_ORIGIN=https://<SERVER_IP>

# Public HTTPS port browsers connect to. Leave at 443 unless that port is
# unavailable on the server. nginx always listens on 443 inside the container;
# this only changes the host-published port.
# Two rules when changing it:
#   1. Add the same port to APP_ORIGIN above (e.g. https://<SERVER_IP>:8080).
#   2. The port-80 -> HTTPS redirect only lands on 443, so with a custom port
#      users must open the full URL (https://<SERVER_IP>:<port>) directly.
HTTPS_PORT=443

# The initial Keycloak realm import resolves APP_ORIGIN into the UI client's
# redirect URI and web origin. For an existing realm, an APP_ORIGIN change still
# requires updating those client settings in Keycloak Admin Console.

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Initial admin credentials, created only during the first Keycloak bootstrap.
KC_BOOTSTRAP_ADMIN_USERNAME=<admin-username>
KC_BOOTSTRAP_ADMIN_PASSWORD=<admin-password>

# Persistent Keycloak PostgreSQL database credentials.
KC_DB_NAME=<db-name>
KC_DB_USERNAME=<db-username>
KC_DB_PASSWORD=<db-password>

# ── UI image build ─────────────────────────────────────────────────────────────
# Standard deployment is same-origin through nginx, so REST, WebSocket, and SSO
# URLs are derived by the UI from the page address at runtime.
# VITE_SSO_CLIENT_ID must match the client defined in keycloak/logstream-realm.json.
VITE_SSO_CLIENT_ID=logstream-ui
VITE_MAX_LOGS_PER_CHANNEL=500
VITE_MAX_MESSAGE_LENGTH=50000

# ── Logstream API ──────────────────────────────────────────────────────────────
# Comma-separated channel names. Downloadable files on the host must be named
# {channel}.log, and the channel must also be included here.
LOGSTREAM_CHANNELS=<channel-a>,<channel-b>
# Host directory containing downloadable {channel}.log files (mounted read-only).
LOGSTREAM_LOG_DIR=<host-log-dir>
# Max concurrent WebSocket sessions per user (each session costs fan-out work
# and up to 2MB of send buffer). 0 disables the cap.
LOGSTREAM_MAX_SESSIONS_PER_USER=5
# Recent events kept per channel and replayed to newly subscribed clients so a
# fresh dashboard shows history instead of a blank panel. 0 disables replay.
LOGSTREAM_REPLAY_BUFFER_SIZE=500
JVM_MAX_HEAP=512m

# ── Redis ──────────────────────────────────────────────────────────────────────
# Redis remains a separately managed dependency. It must be attached to
# the shared monitoring network and advertise an address reachable from logstream.
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<password-if-any>
